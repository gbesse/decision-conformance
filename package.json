  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "verify:node-red": "node scripts/verify-node-red.mjs"
  },
  "devDependencies": {
    "node-red": "5.0.7",
    "node-red-node-test-helper": "0.3.6",
    "node-red-contrib-jev-decisions": "git+https://github.com/gbesse/node-red-contrib-jev-decisions.git#20e088e41cc0acad82cbf496842392d810573eab"

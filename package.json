{
  "name": "@gbesse/decision-conformance",
  "description": "Run portable behavioral conformance scenarios against Jev decision integrations.",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "src",
    "web",
    "examples",
    "scripts",
    "docs",
    "README.md",
    "LICENSE",
    "adapters",
    "reports"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbesse/decision-conformance.git"
  },
  "dependencies": {
